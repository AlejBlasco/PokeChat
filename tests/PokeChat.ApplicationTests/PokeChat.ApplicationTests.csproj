<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PokeChat.ApplicationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      CA1707: test method names use underscores by convention (Method_Scenario_Result).
      CA1859: concrete type preferred — acceptable in test helpers for simplicity.
      Both suppressed at warning level to avoid conflict with TreatWarningsAsErrors in Directory.Build.props.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1859</NoWarn>
    <WarningsNotAsErrors>CA1707;CA1859</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PokeChat.Application\PokeChat.Application.csproj" />
  </ItemGroup>

</Project>
